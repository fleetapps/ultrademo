# Copy to .env for docker compose. Never commit real keys.
ANTHROPIC_API_KEY=
ELEVEN_API_KEY=
# Speech to text: "deepgram" (needs DEEPGRAM_API_KEY) or "elevenlabs" (uses ELEVEN_API_KEY).
ULTRADEMO_AGENT_STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# "production" makes the api refuse to start while any secret below is still a default.
ULTRADEMO_ENVIRONMENT=development

# Shared by api, operator and agent for service-to-service calls. Use a long random value.
ULTRADEMO_INTERNAL_TOKEN=change-me
# Signs the receipt the player uses to report CTA clicks and feedback. Use a long random value.
ULTRADEMO_RECEIPT_SECRET=change-me-too

# Follow-up email to viewers after a demo (optional). Leave ULTRADEMO_SMTP_URL empty to turn it off.
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465. Any provider's SMTP relay works.
ULTRADEMO_SMTP_URL=
ULTRADEMO_EMAIL_FROM="Acme demos <demos@acme.example>"

# Local LiveKit server in --dev mode uses these fixed credentials.
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Docker Desktop (Mac, Windows): set this to your computer's local IP address, or the call joins
# with no screen and no sound. On a Mac: ipconfig getifaddr en0. Leave empty on Linux.
LIVEKIT_NODE_IP=
